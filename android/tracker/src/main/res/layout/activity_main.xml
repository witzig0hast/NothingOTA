<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ================= Aufnahme: Karte + Panel ================= -->
        <FrameLayout
            android:id="@+id/pageRecord"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <FrameLayout
                android:id="@+id/mapContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- top controls -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="3dp"
                    app:contentPaddingBottom="8dp"
                    app:contentPaddingLeft="14dp"
                    app:contentPaddingRight="14dp"
                    app:contentPaddingTop="8dp">

                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <View android:id="@+id/gpsDot" android:layout_width="10dp" android:layout_height="10dp" android:layout_marginEnd="8dp" android:background="@drawable/dot" />
                        <TextView android:id="@+id/gpsText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="GPS" android:textAppearance="@style/TextAppearance.Material3.LabelLarge" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton android:id="@+id/voiceButton" style="@style/MapButton" app:icon="@drawable/ic_voice" />
                <com.google.android.material.button.MaterialButton android:id="@+id/layerButton" style="@style/MapButton" app:icon="@drawable/ic_layers" />
                <com.google.android.material.button.MaterialButton android:id="@+id/centerButton" style="@style/MapButton" app:icon="@drawable/ic_center" />
            </LinearLayout>

            <!-- turn-by-turn banner -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/navCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="72dp"
                android:visibility="gone"
                app:cardBackgroundColor="#141414"
                app:cardElevation="6dp"
                app:contentPadding="14dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:id="@+id/navArrow" android:layout_width="64dp" android:layout_height="wrap_content" android:gravity="center" android:text="↑" android:textColor="#FFFFFF" android:textSize="44sp" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/navDist" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="26sp" android:textStyle="bold" />
                        <TextView android:id="@+id/navText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#E6FFFFFF" android:textSize="15sp" />
                        <TextView android:id="@+id/navRemain" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#99FFFFFF" android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- bottom panel -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_margin="10dp"
                app:cardElevation="6dp"
                app:contentPadding="16dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

                    <!-- before start -->
                    <LinearLayout android:id="@+id/readyBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
                            <com.google.android.material.chip.ChipGroup
                                android:id="@+id/sportChips"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:selectionRequired="true"
                                app:singleLine="true"
                                app:singleSelection="true" />
                        </HorizontalScrollView>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                            <com.google.android.material.chip.Chip
                                android:id="@+id/planChip"
                                style="@style/Widget.Material3.Chip.Assist.Elevated"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:text="Route planen"
                                app:chipIcon="@drawable/ic_search" />
                            <com.google.android.material.chip.Chip
                                android:id="@+id/routeChip"
                                style="@style/Widget.Material3.Chip.Assist"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxWidth="220dp"
                                android:text="GPX importieren"
                                app:chipIcon="@drawable/ic_route" />
                        </LinearLayout>
                        <TextView android:id="@+id/readyInfo" style="@style/Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" />
                    </LinearLayout>

                    <!-- live -->
                    <LinearLayout android:id="@+id/liveBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="bottom" android:orientation="horizontal">
                            <TextView android:id="@+id/timeValue" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="0:00" android:textAppearance="@style/Huge" />
                            <TextView android:id="@+id/stateLabel" style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="14dp" />
                        </LinearLayout>
                        <GridLayout android:id="@+id/metrics" android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="3" />
                        <TextView android:id="@+id/hrStatus" style="@style/Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" />
                        <TextView android:id="@+id/routeInfo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Material3.LabelLarge" android:visibility="gone" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/stopButton"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="60dp"
                            android:layout_marginEnd="8dp"
                            android:text="Ende"
                            android:visibility="gone"
                            app:icon="@drawable/ic_stop" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/lapButton"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="60dp"
                            android:layout_marginEnd="8dp"
                            android:text="Runde"
                            android:visibility="gone"
                            app:icon="@drawable/ic_flag" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/mainButton"
                            android:layout_width="0dp"
                            android:layout_height="60dp"
                            android:layout_weight="1"
                            android:text="Start"
                            android:textSize="18sp"
                            app:icon="@drawable/ic_play" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/countdown"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_gravity="center"
                android:background="@drawable/dot"
                android:backgroundTint="@color/brand"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="72sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <!-- ================= Aktivitäten ================= -->
        <androidx.core.widget.NestedScrollView android:id="@+id/pageHistory" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingHorizontal="4dp" android:text="Aktivitäten" android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium" android:textStyle="bold" />
                <TextView android:id="@+id/totals" style="@style/Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingHorizontal="4dp" android:paddingBottom="8dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/importButton"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Trainings von der Uhr übernehmen"
                    app:icon="@drawable/ic_watch" />
                <LinearLayout android:id="@+id/historyList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ================= Statistik ================= -->
        <androidx.core.widget.NestedScrollView android:id="@+id/pageStats" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingHorizontal="4dp" android:paddingBottom="8dp" android:text="Statistik" android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium" android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Diese Woche" />
                        <TextView android:id="@+id/weekValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="@style/BigNumber" />
                        <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/goalProgress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:trackCornerRadius="6dp" app:trackThickness="10dp" />
                        <TextView android:id="@+id/goalText" style="@style/Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" />
                        <io.github.witzig0hast.cmftrack.BarChartView android:id="@+id/weekChart" android:layout_width="match_parent" android:layout_height="160dp" android:layout_marginTop="16dp" />
                        <TextView style="@style/Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="km pro Woche · letzte 12 Wochen · gestrichelt: Ziel" android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
                    <GridLayout android:id="@+id/totalsGrid" android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="3" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView style="@style/SectionTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Persönliche Bestzeiten (Laufen)" />
                        <LinearLayout android:id="@+id/records" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ================= Profil ================= -->
        <androidx.core.widget.NestedScrollView android:id="@+id/pageProfile" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingHorizontal="4dp" android:paddingBottom="8dp" android:text="Profil" android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium" android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView style="@style/SectionTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Puls von der Uhr" />
                        <TextView android:id="@+id/hcStatus" style="@style/Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/hcButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Health Connect freigeben" app:icon="@drawable/ic_heart" />
                        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/liveHrSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Zusätzlich Brustgurt/Pulssender per Bluetooth" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView style="@style/SectionTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Aufnahme" />
                        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/voiceSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sprachansage pro Kilometer" />
                        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/countdownSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Countdown 3-2-1 vor dem Start" />
                        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/hcWriteSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Trainings in Health Connect speichern" />
                        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="Wochenziel (km)">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/goalInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView style="@style/SectionTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Körper (Kalorien &amp; Pulszonen)" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:layout_weight="1" android:hint="Gewicht kg">
                                <com.google.android.material.textfield.TextInputEditText android:id="@+id/weightInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" />
                            </com.google.android.material.textfield.TextInputLayout>
                            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:layout_weight="1" android:hint="Alter">
                                <com.google.android.material.textfield.TextInputEditText android:id="@+id/ageInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" />
                            </com.google.android.material.textfield.TextInputLayout>
                            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="HFmax">
                                <com.google.android.material.textfield.TextInputEditText android:id="@+id/maxHrInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/femaleSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Weiblich (Kalorienformel)" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView style="@style/SectionTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Home Assistant" />
                        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="Server-Adresse" app:placeholderText="http://192.168.1.10:8080">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/serverInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textUri" android:singleLine="true" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="API-Token" app:endIconMode="password_toggle">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/tokenInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" android:singleLine="true" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/autoUploadSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Nach jedem Training automatisch senden" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:menu="@menu/nav" />
</LinearLayout>
